#!/bin/bash
set -uo pipefail

STATE=/run/firewall
CHECK_INTERVAL=10

log() {
    echo "$(date -Is) $*"
}

expected="$(cat "$STATE/expected")"
while true; do
    if [ "$(nft list table inet container_firewall 2> /dev/null | sha256sum)" = "$expected" ]; then
        touch "$STATE/verified"
    elif nft -f "$STATE/rules" && [ "$(nft list table inet container_firewall | sha256sum)" = "$expected" ]; then
        log "the rules in force differed from /config/config: applied again"
        touch "$STATE/verified"
    else
        log "the rules in force differ from /config/config and cannot be applied again"
        rm -f "$STATE/verified"
    fi
    sleep "$CHECK_INTERVAL"
done
